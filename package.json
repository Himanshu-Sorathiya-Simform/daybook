{
	"name": "daybook",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.integration.config.mts",
		"test:e2e": "playwright test",
		"docs:check": "node scripts/docs-check.mjs",
		"db:bootstrap": "tsx --conditions=react-server scripts/db/bootstrap.ts",
		"db:check-connections": "tsx --conditions=react-server scripts/db/check-connections.ts",
		"db:generate": "NODE_OPTIONS=--conditions=react-server drizzle-kit generate",
		"db:migrate": "tsx --conditions=react-server scripts/db/migrate.ts",
		"db:verify": "tsx --conditions=react-server scripts/db/verify.ts"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"better-auth": "^1.7.12",
		"cn": "^0.5.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.61.0",
		"next": "16.4.2",
		"pg": "^8.23.1",
		"react": "19.3.0",
		"react-aria-components": "^1.22.1",
		"react-dom": "19.3.0",
		"server-only": "^0.0.1",
		"sonner": "^2.0.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@tailwindcss/turbopack": "^4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"babel-plugin-react-compiler": "1.0.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9",
		"eslint-config-next": "16.4.2",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4",
		"tailwindcss-react-aria-components": "^2.2.0",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@11.20.0"
}
