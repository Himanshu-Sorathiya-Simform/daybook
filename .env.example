# Daybook environment variables. Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit a real value (SEC-9). Every value below is a placeholder.
#
# Tests and database scripts can point at the Neon `test` branch through `.env.test`,
# which uses these same names with the test branch's values. A database script reads
# `.env` unless given another file: `pnpm db:bootstrap --env .env.test`.

# --- App ---------------------------------------------------------------------------

# The app's one origin: origin checks, Better Auth's base URL, the CSP. No trailing slash.
APP_ORIGIN=http://localhost:3000

# Signs Better Auth's sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-32-or-more-characters

# The build the write queue must match (D-434). Leave empty locally (it becomes `dev`);
# CI and deployments set it to the commit.
BUILD_ID=

# --- Database: the owner (scripts only) ----------------------------------------------

# Neon's default owner role over the DIRECT endpoint: the host has no `-pooler`.
# Used only by `db:bootstrap`, `db:migrate` and `db:verify`. The app never reads it.
DATABASE_URL_OWNER=postgresql://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=verify-full

# Passwords `db:bootstrap` gives the three Daybook roles. At least 16 characters each.
# Generate each with: openssl rand -base64 32
DB_PASSWORD_AUTH=replace-with-a-random-password
DB_PASSWORD_RUNTIME=replace-with-a-random-password
DB_PASSWORD_SYSTEM=replace-with-a-random-password

# --- Database: the app's three roles (after `db:bootstrap`) -------------------------

# The POOLED endpoint (host has `-pooler`), one URL per role, each with the password above.
# The app checks that each URL's user matches its slot.
DATABASE_URL_AUTH=postgresql://daybook_auth:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_RUNTIME=postgresql://daybook_runtime:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_SYSTEM=postgresql://daybook_system:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full

# --- Database tests (`.env.test` only) ----------------------------------------------

# `pnpm test:integration` refuses to run without this marker, so the database tests can
# never write to the main branch. Put it in `.env.test`, never in `.env`.
# DAYBOOK_TEST_DATABASE=true
